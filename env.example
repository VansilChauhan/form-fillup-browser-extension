# Copy to `.env` in this folder, then reload the extension in chrome://extensions.
# Keys match field name / id / label / aria-label / placeholder, ignoring case,
# spaces, underscores and dashes: FIRST_NAME == firstName == "First Name".
FIRST_NAME=Jane
LAST_NAME=Doe
EMAIL=jane@example.com
PHONE="+1 555 0100"
COUNTRY=United States      # selects match option value or text
SUBSCRIBE=true             # checkboxes: true/1/yes/on
